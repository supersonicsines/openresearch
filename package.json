{
  "name": "openresearch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public research prompts funded by donated OpenRouter credit.",
  "license": "MIT",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/setup.mjs --quiet && vite dev --port 5173",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "demo": "node scripts/demo.mjs",
    "preflight": "node scripts/preflight.mjs",
    "backup": "node scripts/backup.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "qa:sweep": "node scripts/qa-sweep.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf node_modules build build-e2e build-e2e-server .svelte-kit test-results data-e2e data-e2e-server playwright-report"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
