# Created automatically by `npm run setup`. Values may be edited afterwards.
# Every setting is explained in docs/DEPLOY.md.

# The address at which the site is opened, with no trailing slash. It is fixed when `npm run build`
# is run, so a rebuild is required if it is changed. A public address must use https.
ORIGIN=http://localhost:3000
PORT=3000
# Only this machine can connect. A public server should keep this, behind an HTTPS proxy.
HOST=127.0.0.1

# Required on a public address, so that visitors can be told apart behind the proxy.
# Caddy and nginx both send X-Forwarded-For. XFF_DEPTH is the number of proxies in front of the site.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# X sign-in: a Web App with OAuth 2.0 is created at developer.x.com.
# The callback registered must be exactly ORIGIN followed by /auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Encrypts stored OpenRouter keys. If it is lost, stored keys cannot be read.
ENCRYPTION_KEY=

# X handles allowed into /admin, separated by commas. It is the only way to take anything down.
ADMIN_HANDLES=

# Shown on the terms and privacy pages for complaints and removal requests.
CONTACT_EMAIL=

# A flood limit per account. 0 removes it.
MAX_PROMPTS_PER_HOUR=20

# How many projects may be researched at the same time.
MAX_ACTIVE_PROJECTS=16

# Where the database and repositories are kept.
DATA_DIR=data
